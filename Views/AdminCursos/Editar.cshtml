@model Curso
@{
    ViewData["Title"] = "Editar curso";
}

<h1 class="h3 mb-3">Editar curso</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
            <partial name="_Campos" />
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>
