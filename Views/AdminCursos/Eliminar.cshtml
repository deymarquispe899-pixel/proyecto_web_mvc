@model Curso
@{
    ViewData["Title"] = "Eliminar curso";
}

<h1 class="h3 text-danger mb-3">Eliminar curso</h1>

<div class="alert alert-warning">
    Vas a eliminar <strong>@Model.Titulo</strong>. Se borrarán también sus
    <strong>@Model.Lecciones.Count lecciones</strong>, las
    <strong>@Model.Inscripciones.Count inscripciones</strong> y el progreso de los suscriptores.
    Esta acción no se puede deshacer.
</div>

<form asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>
