@model List<Curso>
@{
    ViewData["Title"] = "Administrar cursos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Administrar cursos</h1>
    <a class="btn btn-primary" asp-action="Crear">+ Nuevo curso</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay cursos creados todavía.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Título</th>
                    <th>Nivel</th>
                    <th>Duración</th>
                    <th class="text-center">Lecciones</th>
                    <th class="text-center">Inscritos</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Titulo</td>
                        <td>@c.Nivel.Nombre()</td>
                        <td>@c.DuracionHoras h</td>
                        <td class="text-center">@c.Lecciones.Count</td>
                        <td class="text-center">@c.Inscripciones.Count</td>
                        <td>
                            @if (c.Publicado)
                            {
                                <span class="badge bg-success">Publicado</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Borrador</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-controller="AdminLecciones" asp-action="Index" asp-route-cursoId="@c.Id">Lecciones</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Suscriptores" asp-route-id="@c.Id">Suscriptores</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@c.Id">Editar</a>
                            <form asp-action="Publicar" asp-route-id="@c.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(c.Publicado ? "btn-outline-warning" : "btn-outline-success")">
                                    @(c.Publicado ? "Despublicar" : "Publicar")
                                </button>
                            </form>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Eliminar" asp-route-id="@c.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
