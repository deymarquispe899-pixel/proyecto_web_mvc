@model Leccion
@{
    ViewData["Title"] = "Nueva lección";
}

<h1 class="h3 mb-1">Nueva lección</h1>
<p class="text-muted">Curso: @ViewBag.CursoTitulo</p>

<div class="row">
    <div class="col-lg-9">
        <form asp-action="Crear" asp-route-cursoId="@Model.CursoId" method="post">
            <partial name="_Campos" />
            <button type="submit" class="btn btn-primary">Agregar lección</button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-cursoId="@Model.CursoId">Cancelar</a>
        </form>
    </div>
</div>
