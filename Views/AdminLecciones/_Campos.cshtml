@model Leccion

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Titulo" class="form-label"></label>
    <input asp-for="Titulo" class="form-control" />
    <span asp-validation-for="Titulo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Contenido" class="form-label"></label>
    <textarea asp-for="Contenido" class="form-control font-monospace" rows="12"></textarea>
    <span asp-validation-for="Contenido" class="text-danger"></span>
    <div class="form-text">Puedes escribir texto o HTML sencillo (p, strong, ul, pre, code, etc.).</div>
</div>
