@model CursoDetalleViewModel
@{
    ViewData["Title"] = Model.Curso.Titulo;
    var esSuscriptor = User.IsInRole(RolesApp.Suscriptor);
    var esAdmin = User.IsInRole(RolesApp.Admin);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Catálogo</a></li>
        <li class="breadcrumb-item active">@Model.Curso.Titulo</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-8">
        <h1 class="h2">@Model.Curso.Titulo</h1>
        <p class="mb-3">
            <span class="badge bg-info text-dark">@Model.Curso.Nivel.Nombre()</span>
            <span class="badge bg-secondary">@Model.Curso.DuracionHoras horas</span>
            <span class="badge bg-light text-dark border">@Model.Lecciones.Count lecciones</span>
        </p>
        <p class="lead" style="white-space: pre-line">@Model.Curso.Descripcion</p>

        <h2 class="h5 mt-4">Contenido del curso</h2>
        @if (!Model.Lecciones.Any())
        {
            <p class="text-muted">Este curso aún no tiene lecciones.</p>
        }
        else
        {
            <ol class="list-group list-group-numbered">
                @foreach (var l in Model.Lecciones)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @if (Model.Inscrito)
                        {
                            <a asp-controller="Lecciones" asp-action="Ver" asp-route-id="@l.Id">@l.Titulo</a>
                        }
                        else
                        {
                            <span>@l.Titulo</span>
                            <span title="Inscríbete para acceder">🔒</span>
                        }
                    </li>
                }
            </ol>
        }
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <p>Inicia sesión para inscribirte gratis en este curso.</p>
                    <a class="btn btn-primary w-100"
                       asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@Context.Request.Path">Ingresar para inscribirme</a>
                }
                else if (esSuscriptor && Model.Inscrito)
                {
                    <p class="text-success fw-semibold">✔ Ya estás inscrito</p>
                    <a class="btn btn-success w-100" asp-controller="MisCursos" asp-action="Detalle" asp-route-id="@Model.Curso.Id">Ir al curso</a>
                }
                else if (esSuscriptor)
                {
                    <p>Curso gratuito</p>
                    <form asp-action="Inscribirse" asp-route-id="@Model.Curso.Id" method="post">
                        <button type="submit" class="btn btn-primary w-100">Inscribirme</button>
                    </form>
                }
                else if (esAdmin)
                {
                    <p class="text-muted">Estás como administrador.</p>
                    <a class="btn btn-outline-primary w-100" asp-controller="AdminLecciones" asp-action="Index" asp-route-cursoId="@Model.Curso.Id">Gestionar lecciones</a>
                }
            </div>
        </div>
    </div>
</div>
